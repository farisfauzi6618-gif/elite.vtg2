{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "installCommand": "pnpm install --frozen-lockfile",
  "regions": [
    "sin1"
  ],
  "functions": {
    "app/api/**/route.ts": {
      "maxDuration": 120
    }
  },
  "crons": [
    {
      "path": "/api/cron/weekly-featured",
      "schedule": "0 2 * * 1"
    }
  ]
}
