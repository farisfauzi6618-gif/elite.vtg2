# Local defaults. Configure production values in Vercel Environment Variables.
SITE_ORIGIN=http://localhost:3000
TURSO_DATABASE_URL=file:.data/elite.db
TURSO_AUTH_TOKEN=

# A private Vercel Blob store. Local development falls back to .data/files.
BLOB_READ_WRITE_TOKEN=

# Owner-controlled payment destinations. No NEXT_PUBLIC_ prefix; never commit production values.
PAYMENT_BCA_ACCOUNT_NUMBER=
PAYMENT_BCA_ACCOUNT_HOLDER=
PAYMENT_QRIS_KEY=
PAYMENT_QRIS_MIME=
PAYMENT_QRIS_MERCHANT=
PAYMENT_QRIS_SHA256=

# One owner account; generate the hash with: pnpm admin:password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# Generate distinct random values with: pnpm secrets:generate
AUTH_SECRET=
CONFIG_SECRET=
TEAM_ACCESS_SECRET=
RAJAONGKIR_CONFIG_SECRET=
KIRIMINAJA_WEBHOOK_TOKEN=

# Optional initial RajaOngkir key; also configurable by the owner in /ongkir.
RAJAONGKIR_API_KEY=

# Optional authorized Instagram API integration. Manual caption entry works without it.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_API_VERSION=
